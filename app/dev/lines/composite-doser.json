{
  "about": "Dev check (#/twin?demo=line&line=composite-doser): a composite machine (lib/basics/composite.js, Phase 6 step 4) built from basic blocks in factory.json: portal frame, hung linear axis across the belt, vertical slide, dispensing nozzle. It doses each can, moved by plain move ops.",
  "camera": {
    "position": [
      2.4,
      2.2,
      2.8
    ],
    "target": [
      0,
      1.2,
      0
    ]
  },
  "factory": {
    "version": 1,
    "line": {
      "id": "doseDemo",
      "title": "Dosing demo (composite)",
      "runSize": 6,
      "conventions": {
        "beltHeight": 0.86
      }
    },
    "product": {
      "kind": "catalog",
      "type": "jerryCan",
      "params": {
        "height": 0.33
      }
    },
    "stations": [
      {
        "id": "dose",
        "title": "Dosing",
        "conveyor": "belt",
        "inputStage": "empty",
        "ports": {
          "input": {
            "machine": "belt",
            "port": "input"
          },
          "output": {
            "machine": "belt",
            "port": "output"
          }
        },
        "equipment": [
          {
            "id": "belt",
            "type": "beltConveyor",
            "params": {
              "length": 2.4
            }
          },
          {
            "id": "doser",
            "type": "composite",
            "params": {
              "parts": [
                {
                  "id": "frame",
                  "type": "portalFrame",
                  "params": {
                    "span": 0.8,
                    "height": 2.1
                  }
                },
                {
                  "id": "cross",
                  "type": "linearAxis",
                  "params": {
                    "stroke": 0.5,
                    "hang": true
                  },
                  "on": "frame.beam",
                  "rotationY": 1.5707963267948966
                },
                {
                  "id": "lift",
                  "type": "verticalAxis",
                  "params": {
                    "stroke": 0.25,
                    "bodyLength": 0.35
                  },
                  "on": "cross.carriage"
                },
                {
                  "id": "nozzle",
                  "type": "dispenseNozzle",
                  "params": {
                    "jetLength": 0.15
                  },
                  "on": "lift.ram"
                }
              ],
              "motions": {
                "travel": "cross.travel",
                "lower": "lift.extend",
                "flow": "nozzle.flow"
              },
              "anchors": {
                "tool": "nozzle"
              }
            }
          }
        ],
        "intake": [
          {
            "op": "transfer",
            "conveyor": "belt",
            "to": {
              "machine": "belt",
              "port": "input",
              "offset": [
                1.2,
                0,
                0
              ]
            },
            "label": "Can to the doser"
          }
        ],
        "process": [
          {
            "op": "move",
            "machine": "doser",
            "to": {
              "lower": 0.2
            },
            "seconds": 1,
            "label": "Nozzle down"
          },
          {
            "op": "move",
            "machine": "doser",
            "to": {
              "flow": 1
            },
            "seconds": 0.3,
            "label": "Valve open"
          },
          {
            "op": "wait",
            "seconds": 2,
            "label": "Dosing"
          },
          {
            "op": "move",
            "machine": "doser",
            "to": {
              "flow": 0
            },
            "seconds": 0.3,
            "label": "Valve closed"
          },
          {
            "op": "move",
            "machine": "doser",
            "to": {
              "lower": 0
            },
            "seconds": 1,
            "label": "Nozzle up"
          }
        ],
        "output": [
          {
            "op": "transfer",
            "conveyor": "belt",
            "to": "output",
            "label": "Can out"
          }
        ],
        "feed": {
          "fromLift": false
        }
      }
    ],
    "graph": {
      "edges": []
    }
  }
}
