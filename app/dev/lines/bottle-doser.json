{
  "about": "Dev check (#/twin?demo=line&line=bottle-doser): a parametric product (Phase 6 step 7: a glass bottle described by shape and size) filled by the composite doser (its fill routine runs while the nozzle doses), then labelled.",
  "camera": {
    "position": [
      1.6,
      1.6,
      1.9
    ],
    "target": [
      0,
      1.1,
      0
    ]
  },
  "factory": {
    "version": 1,
    "line": {
      "id": "bottleDemo",
      "title": "Bottle dosing (parametric product)",
      "runSize": 6,
      "conventions": {
        "beltHeight": 0.86
      }
    },
    "product": {
      "kind": "parametric",
      "params": {
        "shape": "bottle",
        "length": 0.09,
        "width": 0.09,
        "height": 0.26,
        "labelText": "APPLE JUICE",
        "liquid": "#d9a21b"
      }
    },
    "stations": [
      {
        "id": "dose",
        "title": "Dosing",
        "conveyor": "belt",
        "inputStage": "raw",
        "ports": {
          "input": {
            "machine": "belt",
            "port": "input"
          },
          "output": {
            "machine": "belt",
            "port": "output"
          }
        },
        "equipment": [
          {
            "id": "belt",
            "type": "beltConveyor",
            "params": {
              "length": 2.4
            }
          },
          {
            "id": "doser",
            "type": "composite",
            "params": {
              "parts": [
                {
                  "id": "frame",
                  "type": "portalFrame",
                  "params": {
                    "span": 0.8,
                    "height": 2
                  }
                },
                {
                  "id": "cross",
                  "type": "linearAxis",
                  "params": {
                    "stroke": 0.5,
                    "hang": true
                  },
                  "on": "frame.beam",
                  "rotationY": 1.5707963267948966
                },
                {
                  "id": "lift",
                  "type": "verticalAxis",
                  "params": {
                    "stroke": 0.25,
                    "bodyLength": 0.35
                  },
                  "on": "cross.carriage"
                },
                {
                  "id": "nozzle",
                  "type": "dispenseNozzle",
                  "params": {
                    "jetLength": 0.15
                  },
                  "on": "lift.ram"
                }
              ],
              "motions": {
                "travel": "cross.travel",
                "lower": "lift.extend",
                "flow": "nozzle.flow"
              },
              "anchors": {
                "tool": "nozzle"
              }
            }
          }
        ],
        "intake": [
          {
            "op": "transfer",
            "conveyor": "belt",
            "to": {
              "machine": "belt",
              "port": "input",
              "offset": [
                1.2,
                0,
                0
              ]
            },
            "label": "Can to the doser"
          }
        ],
        "process": [
          {
            "op": "move",
            "machine": "doser",
            "to": {
              "lower": 0.2
            },
            "seconds": 1,
            "label": "Nozzle down"
          },
          {
            "op": "move",
            "machine": "doser",
            "to": {
              "flow": 1
            },
            "seconds": 0.3,
            "label": "Valve open"
          },
          {
            "op": "runRoutine",
            "routine": "fill",
            "seconds": 3,
            "label": "Filling"
          },
          {
            "op": "move",
            "machine": "doser",
            "to": {
              "flow": 0
            },
            "seconds": 0.3,
            "label": "Valve closed"
          },
          {
            "op": "move",
            "machine": "doser",
            "to": {
              "lower": 0
            },
            "seconds": 1,
            "label": "Nozzle up"
          },
          {
            "op": "runRoutine",
            "routine": "label",
            "seconds": 1.2,
            "label": "Labelling"
          }
        ],
        "output": [
          {
            "op": "transfer",
            "conveyor": "belt",
            "to": "output",
            "label": "Can out"
          }
        ],
        "feed": {
          "fromLift": false
        }
      }
    ],
    "graph": {
      "edges": []
    }
  }
}
