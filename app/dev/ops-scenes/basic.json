{
  "about": "Dev check scene for the basic ops (#/twin?demo=ops, scene basic). A preview of factory.json: equipment by catalog type, items, and a process written only with basic ops. Plays in a loop.",
  "workState": "ASSEMBLING",
  "camera": { "position": [4.2, 3.4, 5.4], "target": [0, 1.0, -0.2] },
  "equipment": [
    { "id": "line", "type": "palletConveyor", "params": {}, "position": [0, 0, 0] },
    { "id": "robot", "type": "cartesianGantry", "params": { "spanX": 1.6, "spanZ": 1.4, "frameColor": "machineBlue" }, "position": [0, 0, 0] },
    { "id": "bench", "type": "workTable", "params": { "length": 0.6, "width": 0.4, "height": 0.85 }, "position": [-0.5, 0, -0.6] }
  ],
  "product": { "box": [0.6, 0.03, 0.4], "color": "frameDark", "at": [-1.6, 0.85, 0] },
  "items": {
    "part": { "box": [0.08, 0.08, 0.08], "color": "gantryOrange", "at": [-0.5, 0.85, -0.6] }
  },
  "start": { "product": { "machine": "line", "port": "input" } },
  "process": [
    { "op": "transfer", "conveyor": "line", "from": "input", "to": "work", "label": "Carrier to work position", "state": "INFEED" },
    { "op": "grip", "machine": "line", "item": "product", "motion": "locate", "to": 1, "anchor": "carrier", "seconds": 0.4, "label": "Lift & locate carrier", "state": "INFEED" },
    { "op": "move", "machine": "robot", "to": { "x": -0.5, "y": 1.2, "z": -0.6 }, "speed": 0.6, "label": "Moving over the part" },
    { "op": "move", "machine": "robot", "to": { "y": 0.89 }, "seconds": 0.6, "label": "Descending" },
    { "op": "grip", "machine": "robot", "item": "part", "to": 0.08, "label": "Gripping part" },
    { "op": "move", "machine": "robot", "to": { "y": 1.2 }, "seconds": 0.5, "label": "Lifting part" },
    { "op": "move", "machine": "robot", "to": { "x": 0, "z": 0, "yaw": 1.5708 }, "speed": 0.6, "profile": "trapezoid", "label": "Transferring part" },
    { "op": "move", "machine": "robot", "to": { "y": 0.95 }, "seconds": 0.6, "label": "Placing part" },
    { "op": "release", "machine": "robot", "item": "part", "to": 0.2, "onto": "product", "label": "Releasing part" },
    { "op": "move", "machine": "robot", "to": { "y": 1.6, "yaw": 0 }, "seconds": 0.8, "label": "Robot clear" },
    { "op": "decide", "on": "quality", "cases": {
        "pass": [{ "op": "wait", "seconds": 0.4, "label": "Check OK", "state": "CHECKING" }],
        "fail": [{ "op": "rotate", "machine": "robot", "motion": "yaw", "by": 6.2832, "seconds": 1.2, "label": "Reject: robot signals", "state": "CHECKING" }]
    } },
    { "op": "release", "machine": "line", "item": "product", "motion": "locate", "to": 0, "seconds": 0.35, "label": "Releasing carrier", "state": "OUTPUT" },
    { "op": "transfer", "conveyor": "line", "to": "output", "label": "Transport to output port", "state": "OUTPUT" }
  ]
}
