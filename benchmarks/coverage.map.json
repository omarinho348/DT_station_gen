{
  "about": "What each catalog component and op can show, by DIN 8580 (manufacturing processes, main groups 1-6), DIN 8593 (joining, the subgroups of 4) and VDI 2860 (handling functions). scripts/coverage.mjs checks that every registry entry is mapped and writes benchmarks/coverage.md. [] marks station furniture and infrastructure (no process).",
  "standards": {
    "DIN 8580": {
      "1": "Primary shaping (Urformen): casting, sintering, additive manufacturing",
      "2": "Forming (Umformen): bending, pressing, deep drawing, folding",
      "3": "Separating (Trennen): cutting, machining, punching, laser cutting",
      "4": "Joining (Fügen): see DIN 8593",
      "5": "Coating (Beschichten): painting, spraying, dispensing a layer",
      "6": "Changing material properties (Stoffeigenschaften ändern): heat treatment, curing, laser marking"
    },
    "DIN 8593": {
      "4.1": "Assembling (Zusammensetzen): placing, inserting, nesting, hanging",
      "4.2": "Filling (Füllen)",
      "4.3": "Pressing on / in (An- und Einpressen): screwing, press-fitting, clamping",
      "4.4": "Joining by primary shaping (Fügen durch Urformen): potting, encapsulating",
      "4.5": "Joining by forming (Fügen durch Umformen): riveting, crimping, folding seams",
      "4.6": "Welding (Schweißen)",
      "4.7": "Soldering (Löten)",
      "4.8": "Adhesive bonding (Kleben): gluing, labels, tape",
      "4.9": "Textile joining (Textiles Fügen): sewing, stitching"
    },
    "VDI 2860": {
      "store": "Storing (Speichern): magazines, buffers, racks, totes",
      "quantity": "Changing quantity (Mengen verändern): separating, allotting, branching, merging, grouping, sorting",
      "move": "Moving (Bewegen): turning, shifting, orienting, positioning, guiding, passing on",
      "secure": "Securing (Sichern): holding, releasing, clamping, locating",
      "check": "Checking (Kontrollieren): inspecting, measuring, testing"
    }
  },
