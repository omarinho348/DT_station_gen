{
  "version": 1,
  "line": {
    "id": "controlBoardAssembly",
    "title": "Control board assembly on pallet carriers",
    "runSize": 8
  },
  "product": {
    "kind": "parametric",
    "params": {
      "shape": "box",
      "length": 0.16,
      "width": 0.1,
      "height": 0.1,
      "finish": "cardboard",
      "color": "#00A000",
      "processedColor": "#00A000"
    }
  },
  "stations": [
    {
      "id": "pasteSolderPaste",
      "code": "ST1",
      "title": "Solder paste dispense",
      "shell": {
        "type": "assemblyCell",
        "params": {
          "code": "ST1",
          "title": "Solder paste dispense",
          "color": "#00A000"
        }
      },
      "equipment": [
        {
          "id": "boardPhotoEye",
          "type": "photoEye",
          "params": {
            "span": 0.4
          },
          "position": [
            0,
            0.85,
            0
          ],
          "rotationY": 0
        },
        {
          "id": "solderPasteDispenser",
          "type": "genericMachine",
          "params": {
            "name": "Solder paste dispenser",
            "note": "Dispense solder paste onto PCB pads",
            "length": 1.6,
            "depth": 1.2,
            "height": 1.9,
            "passThrough": true,
            "carries": "unit"
          },
          "position": [
            0,
            0,
            0
          ],
          "rotationY": 0
        },
        {
          "id": "solderPasteVision",
          "type": "visionScanner",
          "params": {
            "length": 2.7,
            "width": 1.44,
            "railHeight": 2.05,
            "archWidth": 1,
            "archBottom": 1.1
          },
          "position": [
            0,
            0,
            -1.9
          ],
          "rotationY": 0
        },
        {
          "id": "dispenseNozzleTool",
          "type": "dispenseNozzle",
          "params": {
            "jetLength": 0.12,
            "liquid": "glue"
          },
          "position": [
            -2.235,
            0,
            0
          ],
          "rotationY": 0
        }
      ],
      "conveyor": "line",
      "inputStage": "processed",
      "process": [
        {
          "op": "toolOn",
          "machine": "boardPhotoEye",
          "motion": "beam",
          "value": "blocked",
          "then": "clear",
          "seconds": 0.3,
          "label": "Unit detected"
        },
        {
          "op": "operate",
          "machine": "solderPasteDispenser",
          "seconds": 20,
          "label": "Dispense solder paste onto PCB pads"
        },
        {
          "op": "move",
          "machine": "solderPasteVision",
          "to": {
            "x": 0.66
          },
          "switches": {
            "scan": "on"
          },
          "seconds": 2.25,
          "label": "Vision scan · forward pass",
          "state": "INSPECTING"
        },
        {
          "op": "move",
          "machine": "solderPasteVision",
          "to": {
            "x": -0.72
          },
          "seconds": 1.35,
          "label": "Vision scan · return pass",
          "state": "INSPECTING"
        },
        {
          "op": "move",
          "machine": "solderPasteVision",
          "to": {
            "x": -1.2000000000000002
          },
          "switches": {
            "scan": "off"
          },
          "seconds": 0.9,
          "label": "Analysing the images",
          "state": "INSPECTING"
        },
        {
          "op": "decide",
          "on": "quality",
          "planAs": "pass",
          "cases": {
            "pass": [],
            "reject": [
              {
                "op": "transfer",
                "conveyor": "line",
                "to": {
                  "machine": "line",
                  "port": "output"
                },
                "label": "Rejected · to the reject lane",
                "state": "REJECT"
              }
            ]
          }
        }
      ],
      "feed": {
        "fromLift": true
      }
    }
  ],
  "graph": {
    "edges": []
  }
