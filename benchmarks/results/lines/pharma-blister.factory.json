  "graph": {
    "edges": [
      {
        "from": "formBlisterCavities.output",
        "to": "doseTablets.input",
        "transport": {
          "kind": "conveyor",
          "type": "liftUnit",
          "params": {}
        }
      },
      {
        "from": "doseTablets.output",
        "to": "inspectCavities.input",
        "transport": {
          "kind": "conveyor",
          "type": "liftUnit",
          "params": {}
