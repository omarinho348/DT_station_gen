{
  "$id": "https://twingen.local/spec/factory.schema.json",
  "title": "factory.json",
  "description": "A production line digital twin: line, product, stations (shell, equipment, process as ops) and the graph of typed ports. Generated from spec/factory.schema.js; do not edit.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "line": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "units": {
          "default": "m",
          "type": "string",
          "const": "m"
        },
        "flow": {
          "default": "+X",
          "type": "string",
          "const": "+X"
        },
        "runSize": {
          "default": 8,
          "description": "Units released per run",
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        },
        "speeds": {
          "default": [
            1,
            2,
            10
          ],
          "description": "Simulation speed choices",
          "minItems": 1,
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100
          }
        },
        "conventions": {
          "default": {},
          "type": "object",
          "properties": {
            "beltHeight": {
              "description": "Top of the conveyor belts (m)",
              "type": "number",
              "minimum": 0.4,
              "maximum": 1.5
            },
            "conveyor": {
              "type": "object",
              "properties": {
                "speed": {
                  "description": "m/s",
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 3
                },
                "ramp": {
                  "description": "Acceleration ramp (s)",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 3
                }
              }
            },
            "lift": {
              "type": "object",
              "properties": {
                "drop": {
                  "description": "Return line depth below the belt (m)",
                  "type": "number",
                  "minimum": 0.2,
                  "maximum": 1
                },
                "duration": {
                  "description": "Lift move (s)",
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 10
                }
              }
            },
            "transferLength": {
              "description": "Gap between station conveyors (m)",
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10
            },
            "holdSeconds": {
              "description": "Re-check interval of a waiting station (s)",
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 5
            }
          },
          "description": "Overrides of the line conventions (constitution.md); anything left out keeps its default"
        }
      },
      "required": [
        "id",
        "title"
      ]
    },
    "product": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "catalog"
            },
            "type": {
              "type": "string",
              "pattern": "^[a-z][a-zA-Z0-9]*$",
              "description": "Catalog product type"
            },
            "params": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "kind",
            "type"
          ]
        }
      ],
      "description": "What flows down the line"
    },
    "stations": {
      "minItems": 1,
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9]*$"
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "shell": {
            "description": "Shared furniture (slab, conveyor, lifts, sign, HMI, stack light)",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9]*$",
                "description": "Catalog shell preset"
              },
              "params": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "type"
            ]
          },
          "equipment": {
            "default": [],
            "description": "This station's own machines",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-zA-Z0-9]*$"
                },
                "type": {
                  "type": "string",
                  "pattern": "^[a-z][a-zA-Z0-9]*$",
                  "description": "Catalog component type"
                },
                "params": {
                  "default": {},
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "position": {
                  "default": [
                    0,
                    0,
                    0
                  ],
                  "description": "Station-local position (m): flow +X, walkway +Z",
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 3,
                  "maxItems": 3
                },
                "rotationY": {
                  "default": 0,
                  "description": "Turn about the vertical axis (rad)",
                  "type": "number",
                  "minimum": -6.283185307179586,
                  "maximum": 6.283185307179586
                },
                "beltHeight": {
                  "description": "This machine's own belt / surface height when it differs from the line (a lower carton line)",
                  "type": "number",
                  "minimum": 0.2,
                  "maximum": 1.5
                }
              },
              "required": [
                "id",
                "type"
              ]
            }
          },
          "conveyor": {
            "description": "Station conveyor id (default: the shell's)",
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9]*$"
          },
          "workState": {
            "default": "WORKING",
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "role": {
            "default": "station",
            "description": "transfer: a station that carries units between two others (a row former); a line plays it with its transfers, after the stations each frame",
            "type": "string",
            "enum": [
              "station",
              "transfer"
            ]
          },
          "inputStage": {
            "description": "Product stage a unit arrives in",
            "type": "string"
          },
          "unit": {
            "description": "What this station's units are, when not the line product (cases a station upstream packed the products into): fed stand-alone and planned with",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9]*$",
                "description": "Catalog product type"
              },
              "params": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "type"
            ]
          },
          "ports": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-zA-Z0-9]*$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "machine": {
                  "description": "Machine the port belongs to (default: the station conveyor)",
                  "type": "string",
                  "pattern": "^[a-z][a-zA-Z0-9]*$"
                },
                "port": {
                  "description": "Port name on that machine (default: the station port name)",
                  "type": "string",
                  "pattern": "^[a-z][a-zA-Z0-9]*$"
                },
                "offset": {
                  "description": "The place is this far from the machine port, in the machine frame (m): e.g. inside an infeed tunnel",
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 3,
                  "maxItems": 3
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "in",
                    "out"
                  ]
                },
                "slots": {
                  "description": "Extra output: places it holds, filled in turn (the oldest is cleared when full); the station offers the fact <port>Slot",
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                },
                "standalone": {
                  "description": "Machines that only serve this port when it is not connected",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-zA-Z0-9]*$"
                  }
                },
                "connected": {
                  "description": "Machines that only exist when the port is connected (an open-ended hood instead of a closed tunnel)",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-zA-Z0-9]*$"
                  }
                }
              }
            }
          },
          "prepare": {
            "description": "Ops played at the start of each cycle once a unit is waiting, before it is taken in (the station readies itself; they cannot touch the unit)",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "pattern": "^[a-z][a-zA-Z0-9]*$"
                }
              },
              "required": [
                "op"
              ],
              "additionalProperties": {}
            }
          },
          "intake": {
            "description": "Default: raise stop, convey to work, locate",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "pattern": "^[a-z][a-zA-Z0-9]*$"
                }
              },
              "required": [
                "op"
              ],
              "additionalProperties": {}
            }
          },
          "process": {
            "default": [],
            "description": "The station's process as ops (an indexing station leaves it empty)",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "pattern": "^[a-z][a-zA-Z0-9]*$"
                }
              },
              "required": [
                "op"
              ],
              "additionalProperties": {}
            }
          },
          "batch": {
            "description": "Units arrive as batches standing like this (a 2 × 2 group of cans); ops reach single members as items member1 … memberN",
            "type": "object",
            "properties": {
              "members": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12,
                "description": "Units per batch"
              },
              "pitch": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 2,
                "description": "Distance between the units of a row, along X (m)"
              },
              "rows": {
                "default": 1,
                "description": "Rows across the flow (Z)",
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              },
              "rowPitch": {
                "default": 0,
                "description": "Distance between rows, along Z (m)",
                "type": "number",
                "minimum": 0,
                "maximum": 2
              },
              "rowsFrom": {
                "default": "rear",
                "description": "Which row the member numbers start in (rear = −Z)",
                "type": "string",
                "enum": [
                  "rear",
                  "front"
                ]
              }
            },
            "required": [
              "members",
              "pitch"
            ]
          },
          "indexing": {
            "description": "Indexing station: batches of units at positions along the conveyor, moved together one position per machine cycle",
            "type": "object",
            "properties": {
              "members": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12,
                "description": "Units per batch"
              },
              "pitch": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 2,
                "description": "Distance between the units of a batch, along X (m)"
              },
              "positions": {
                "minItems": 2,
                "maxItems": 12,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[a-z][a-zA-Z0-9]*$"
                    },
                    "x": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "name",
                    "x"
                  ]
                },
                "description": "Batch-centre places along the conveyor, in flow order, evenly spaced (station frame, m)"
              },
              "enter": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9]*$",
                "description": "Position where a new batch is taken in (before the index moves it on)"
              },
              "exit": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9]*$",
                "description": "Position the exit phase takes a batch from"
              },
              "index": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string",
                      "pattern": "^[a-z][a-zA-Z0-9]*$"
                    }
                  },
                  "required": [
                    "op"
                  ],
                  "additionalProperties": {}
                },
                "description": "Ops of the index phase; one indexBatches moves the batches"
              },
              "exitOps": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string",
                      "pattern": "^[a-z][a-zA-Z0-9]*$"
                    }
                  },
                  "required": [
                    "op"
                  ],
                  "additionalProperties": {}
                },
                "description": "Ops that take the batch at `exit` away (e.g. dischargeBatch)"
              },
              "work": {
                "default": [],
                "description": "Work at positions, e.g. filling, capping",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "at": {
                      "type": "string",
                      "pattern": "^[a-z][a-zA-Z0-9]*$"
                    },
                    "ops": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "op": {
                            "type": "string",
                            "pattern": "^[a-z][a-zA-Z0-9]*$"
                          }
                        },
                        "required": [
                          "op"
                        ],
                        "additionalProperties": {}
                      }
                    }
                  },
                  "required": [
                    "at",
                    "ops"
                  ]
                }
              },
              "order": {
                "description": "Phase order in a machine cycle: \"index\", \"exit\" and work positions (default: index, exit, then work in order)",
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-zA-Z0-9]*$"
                }
              },
              "preload": {
                "default": [],
                "description": "Positions that hold a batch when the station is reset (the reference filling line starts with one at staging)",
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-zA-Z0-9]*$"
                }
              },
              "startWhen": {
                "default": "always",
                "description": "downstreamEmpty: a machine cycle (the index) only starts while the next station holds no unit (the reference factory holds its filling line so)",
                "type": "string",
                "enum": [
                  "always",
                  "downstreamEmpty"
                ]
              }
            },
            "required": [
              "members",
              "pitch",
              "positions",
              "enter",
              "exit",
              "index",
              "exitOps"
            ]
          },
          "output": {
            "description": "Default: release, convey to output",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "pattern": "^[a-z][a-zA-Z0-9]*$"
                }
              },
              "required": [
                "op"
              ],
              "additionalProperties": {}
            }
          },
          "home": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-zA-Z0-9]*$"
            },
            "additionalProperties": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9]*$"
              },
              "additionalProperties": {
                "type": [
                  "string",
                  "number"
                ]
              }
            }
          },
          "stock": {
            "default": {},
            "description": "Stock items: copies of product parts presented at machine ports (a supermarket)",
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-zA-Z0-9]*$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "part": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                  "description": "Product part this is a copy of"
                },
                "mode": {
                  "default": "kit",
                  "description": "How it rests: as in the kit tray, or as assembled",
                  "type": "string",
                  "enum": [
                    "kit",
                    "asm"
                  ]
                },
                "at": {
                  "type": "object",
                  "properties": {
                    "machine": {
                      "type": "string",
                      "pattern": "^[a-z][a-zA-Z0-9]*$",
                      "description": "Machine holding it (a bin, saddle, nest…)"
                    },
                    "port": {
                      "type": "string",
                      "pattern": "^[a-z][a-zA-Z0-9]*$",
                      "description": "Port it rests on"
                    },
                    "offset": {
                      "default": [
                        0,
                        0,
                        0
                      ],
                      "description": "From the port, machine frame (m)",
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "number"
                        }
                      ],
                      "items": false,
                      "minItems": 3,
                      "maxItems": 3
                    }
                  },
                  "required": [
                    "machine",
                    "port"
                  ]
                }
              },
              "required": [
                "part",
                "at"
              ]
            }
          },
          "stacks": {
            "default": {},
            "description": "Stacks the station builds across units (cases on a pallet); facts <stack>Slot and <stack>Fills",
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-zA-Z0-9]*$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "machine": {
                  "type": "string",
                  "pattern": "^[a-z][a-zA-Z0-9]*$",
                  "description": "Machine the stack is built on (a pallet)"
                },
                "port": {
                  "type": "string",
                  "pattern": "^[a-z][a-zA-Z0-9]*$",
                  "description": "Its surface port"
                },
                "columns": {
                  "minItems": 1,
                  "maxItems": 10,
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "description": "Spot offsets along the machine X (m)"
                },
                "rows": {
                  "minItems": 1,
                  "maxItems": 10,
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "description": "Spot offsets along the machine Z (m)"
                },
                "layers": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                },
                "layerHeight": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 2,
                  "description": "Height of one layer (m)"
                },
                "gap": {
                  "default": 0,
                  "description": "Clearance above the surface / layer below (m)",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 0.05
                }
              },
              "required": [
                "machine",
                "port",
                "columns",
                "rows",
                "layers",
                "layerHeight"
              ]
            }
          },
          "sensors": {
            "default": [],
            "description": "Presence sensors: a machine motion that reads blocked while a unit crosses it (photo-eyes)",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "machine": {
                  "type": "string",
                  "pattern": "^[a-z][a-zA-Z0-9]*$",
                  "description": "The sensor (e.g. a photo-eye standing on the conveyor)"
                },
                "motion": {
                  "default": "beam",
                  "description": "Its motion with the two values below",
                  "type": "string",
                  "pattern": "^[a-z][a-zA-Z0-9]*$"
                },
                "clear": {
                  "default": "clear",
                  "type": "string",
                  "minLength": 1
                },
                "blocked": {
                  "default": "blocked",
                  "type": "string",
                  "minLength": 1
                },
                "across": {
                  "default": 0.75,
                  "description": "Units within this distance across the conveyor (Z) count (m)",
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 3
                }
              },
              "required": [
                "machine"
              ]
            }
          },
          "connections": {
            "default": [],
            "description": "Pipes and hoses between machine anchors (\"machine.anchor\"), e.g. from a supply pump to a machine inlet",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-zA-Z0-9]*$"
                },
                "from": {
                  "type": "string",
                  "pattern": "^[a-z][a-zA-Z0-9]*\\.[a-z][a-zA-Z0-9]*$",
                  "description": "Start: \"machine.anchor\""
                },
                "to": {
                  "type": "string",
                  "pattern": "^[a-z][a-zA-Z0-9]*\\.[a-z][a-zA-Z0-9]*$",
                  "description": "End: \"machine.anchor\""
                },
                "kind": {
                  "default": "pipe",
                  "description": "Rigid pipe run, or flexible hose",
                  "type": "string",
                  "enum": [
                    "pipe",
                    "hose"
                  ]
                },
                "radius": {
                  "description": "Outer radius (m); default 0.026 pipe, 0.018 hose",
                  "type": "number",
                  "minimum": 0.003,
                  "maximum": 0.1
                },
                "material": {
                  "description": "Default stainless (pipe), hose (hose)",
                  "type": "string",
                  "enum": [
                    "stainless",
                    "brushed",
                    "aluminium",
                    "hose",
                    "airLine",
                    "frame",
                    "cableBlack"
                  ]
                },
                "route": {
                  "default": "up",
                  "description": "Pipe: rise to the end height first, or run across first",
                  "type": "string",
                  "enum": [
                    "up",
                    "across"
                  ]
                },
                "flanges": {
                  "default": true,
                  "description": "Pipe: a flange at each end",
                  "type": "boolean"
                },
                "sag": {
                  "default": [
                    0,
                    -0.1,
                    0
                  ],
                  "description": "Hose: offset of its middle from the straight line (m)",
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 3,
                  "maxItems": 3
                },
                "startTangent": {
