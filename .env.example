# Copy to .env and fill in. .env is git-ignored. Never commit or share the key.

OPENAI_API_KEY=

# mock = recorded responses only (tests, CI, demo rehearsal); live = real API calls
LLM_MODE=mock

# Models (chosen when we reach Phase 8). STRONG is used only for plan.md, and only if enabled.
LLM_MODEL_DEFAULT=
LLM_MODEL_STRONG=
LLM_STRONG_ENABLED=false

# Prices in USD per 1M tokens, for the budget guard
LLM_PRICE_DEFAULT_INPUT=
LLM_PRICE_DEFAULT_CACHED_INPUT=
LLM_PRICE_DEFAULT_OUTPUT=
LLM_PRICE_STRONG_INPUT=
LLM_PRICE_STRONG_CACHED_INPUT=
LLM_PRICE_STRONG_OUTPUT=

# Budget caps in USD
LLM_BUDGET_SESSION=0.50
LLM_BUDGET_TOTAL=4.50
